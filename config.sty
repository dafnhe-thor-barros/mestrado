\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config}[2026/10/22 v1.2 Configuracoes Padrao IFES ProPECAut Corrigido]

% ==============================================================================
% 1. PACOTES DE IDIOMA E CODIFICAÇÃO
% ==============================================================================
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[brazilian]{babel}

% ==============================================================================
% 2. FONTES E MATEMÁTICA (TIMES NEW ROMAN)
% ==============================================================================
% amsmath deve ser carregado OBRIGATORIAMENTE antes de newtxmath
\RequirePackage{amsmath}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}

% ==============================================================================
% 3. ELEMENTOS GRÁFICOS, CORES E IMAGENS
% ==============================================================================
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{float}

% ==============================================================================
% 4. GEOMETRIA E MARGENS (PADRÃO ABNT / IFES)
% ==============================================================================
\RequirePackage{geometry}
\geometry{
    a4paper,
    left=3.0cm,
    top=3.0cm,
    right=2.0cm,
    bottom=2.0cm
}

% ==============================================================================
% 5. TIPOGRAFIA, ESPAÇAMENTO E CONTROLE DE MARGEM
% ==============================================================================
\RequirePackage{indentfirst}
\RequirePackage{setspace}
\RequirePackage{microtype}
\setstretch{1.5}
\setlength{\parindent}{1.25cm}
\sloppy

% Flexibilização de quebra de parágrafo para eliminar "Overfull \hbox"
\emergencystretch=2.5em
\hfuzz=1.5pt
\vfuzz=1.5pt

% ==============================================================================
% 6. TABELAS AVANÇADAS E LEGENDAS
% ==============================================================================
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{caption}
\captionsetup{font={small,stretch=1.0}}

% Conforme ABNT NBR 14724: tabelas e notas com espacamento simples
\RequirePackage{etoolbox}
\AtBeginEnvironment{table}{\singlespacing}
\AtBeginEnvironment{figure}{\singlespacing}

% ==============================================================================
% 7. LISTAS E ENUMERAÇÕES
% ==============================================================================
\RequirePackage{enumitem}

% ==============================================================================
% 8. FORMATAÇÃO DE SEÇÕES E TÍTULOS
% ==============================================================================
\RequirePackage{titlesec}
\titleformat{\section}{\bfseries\normalsize\uppercase}{\thesection}{1em}{}
\titleformat{\subsection}{\bfseries\normalsize}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\bfseries\normalsize}{\thesubsubsection}{1em}{}

% ==============================================================================
% 9. REFERÊNCIAS, LINKS E QUEBRAS DE URL
% ==============================================================================
\RequirePackage{cite}
\RequirePackage{url}
% Permite quebra de URLs em caracteres comuns evitando estouro de margem
\def\UrlBreaks{\do\/\do-\do_\do.\do=}

\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=black,
    urlcolor=blue,
    pdfborder={0 0 0},
    breaklinks=true
}
\urlstyle{same}

% ==============================================================================
% 10. LISTAGENS DE CÓDIGO-FONTE (MATLAB / PYTHON)
% ==============================================================================
\RequirePackage{listings}
\lstset{
    language=Matlab,
    basicstyle=\ttfamily\scriptsize\singlespacing,
    keywordstyle=\bfseries\color{blue!80!black},
    commentstyle=\itshape\color{green!40!black},
    stringstyle=\color{purple!70!black},
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    numbersep=6pt,
    backgroundcolor=\color{gray!4},
    frame=single,
    rulecolor=\color{gray!30},
    tabsize=2,
    captionpos=b,
    breaklines=true,
    breakatwhitespace=false,
    showspaces=false,
    showstringspaces=false,
    xleftmargin=12pt,
    framexleftmargin=12pt
}

% ==============================================================================
% 11. MACROS DE COMPATIBILIDADE E ROBUSTEZ (RESOLVE ERROS DO MAIN.LOG)
% ==============================================================================
% Permite usar \chapter em classe article (mapeia como \section)
\providecommand{\chapter}[1]{\section{#1}}

% Permite citações no estilo \citeonline (autor no texto)
\providecommand{\citeonline}[1]{\cite{#1}}

% Define comando \legend para notas de rodapé de figuras e tabelas
\providecommand{\legend}[1]{\vspace{3pt}\par\noindent{\footnotesize #1}\par}

% Define a macro \figcap caso o texto utilize \figcap{arquivo}{largura}
\providecommand{\figcap}[2]{\includegraphics[width=#2]{#1}}

% Cria o ambiente alineaslista mapeado para o enumitem
\newenvironment{alineaslista}{%
    \begin{enumerate}[label=\textbf{\alph*.)},leftmargin=1.5cm,itemsep=2pt,topsep=2pt]%
}{%
    \end{enumerate}%
}